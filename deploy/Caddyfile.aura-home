{
	auto_https disable_redirects
}

http://192.168.55.168, http://aura.home {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle_path /aura-backend* {
		reverse_proxy 192.168.55.4:8100
	}

	reverse_proxy 127.0.0.1:3000
}

https://192.168.55.168, https://aura.home {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle_path /aura-backend* {
		reverse_proxy 192.168.55.4:8100
	}

	reverse_proxy 127.0.0.1:3000
}
